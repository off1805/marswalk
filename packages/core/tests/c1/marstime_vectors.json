      "tolerance_lmst_s": 60,
      "source": "vérification fonctionnelle : pas d'erreur sur une date bissextile terrestre"
    },
    {
      "name": "Année non-bissextile limite (2100-02-28T00:00:00Z)",
      "utc": "2100-02-28T00:00:00Z",
      "lon_east": 0.0,
      "expected": {},
      "tolerance_lmst_s": 60,
      "source": "vérification fonctionnelle : calcul sans crash sur date future éloignée"
    },
    {
      "name": "Frontière de sol — exactement 1 sol après l'époque",
      "utc": "2026-11-02T00:39:36Z",
      "lon_east": 77.58,
      "expected": {
        "sol_min": 2
      },
      "tolerance_lmst_s": 60,
      "note": "1 sol = 88775.244 s ; 88776 s après 2026-11-01T00:00:00Z → sol 2",
      "source": "calcul : 2026-11-01T00:00:00Z + 88776 s = 2026-11-02T00:39:36Z"
    },
    {
