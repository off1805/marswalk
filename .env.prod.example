# Modèle des variables d'environnement de production.
# Copier dans /opt/marswalk/.env.local.sh sur l'instance Lightsail,
# remplir toutes les valeurs, et mettre le fichier en chmod 600.
# NE JAMAIS commiter ce fichier avec des vraies valeurs.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=marswalk
# Générer avec : openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=marswalk

# ── CloudFront ──────────────────────────────────────────────────────────────
# URL d'origine CloudFront de ton frontend (sans barre oblique finale).
# Exemple : https://d1a2b3c4d5e6f7.cloudfront.net
# Ou ton domaine personnalisé si tu en configures un sur la distribution.
CLOUDFRONT_URL=https://CHANGE_ME.cloudfront.net

# ── Domaine de l'instance Lightsail ─────────────────────────────────────────
# Nom de domaine pointant vers l'IP publique de l'instance.
# Let's Encrypt émet le certificat TLS pour ce nom.
# Exemple : api.marswalk.example.com
MARSWALK_DOMAIN=CHANGE_ME

# ── Sauvegarde S3 (utilisé par infra/scripts/backup.sh) ─────────────────────
# Nom du bucket S3 de sauvegarde (sans s3://).
BACKUP_BUCKET=CHANGE_ME-marswalk-backups

# ── Bucket S3 frontend (utilisé par infra/scripts/deploy.sh) ────────────────
FRONTEND_BUCKET=CHANGE_ME-marswalk-frontend

# ── ID de distribution CloudFront (utilisé par infra/scripts/deploy.sh) ─────
CF_DIST_ID=CHANGE_ME
